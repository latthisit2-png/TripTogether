# PostgreSQL
POSTGRES_DB=triptogether
POSTGRES_USER=triptogether_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_PORT=5432

DATABASE_URL="postgresql://triptogether_user:your_strong_password_here@localhost:5432/triptogether"

# Server
PORT=3001
NODE_ENV=development

# Security
# ไม่ต้องกำหนด JWT_SECRET เนื่องจากใช้ Token-based ที่เก็บ hash ใน DB
